# Copy to .env for local dev. Never commit the real file.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_DRIVE_EVIDENCE_FOLDER_ID=
DEADLINE_ALERT_WEBHOOK_URL=
# Optional: enables case/docket verification against CourtListener/RECAP.
# Get a free token at https://www.courtlistener.com/profile/api-token/
COURTLISTENER_API_TOKEN=
# Required for Evidence Vault OCR/text extraction (Phase 2).
# Create a Google Cloud service account, enable the Drive API, download its
# JSON key, and paste the full JSON contents here as a single-line string.
# Then share your evidence folder in Google Drive with the service account's
# email (found in the JSON as "client_email") -- read-only access is enough.
GOOGLE_SERVICE_ACCOUNT_JSON=
